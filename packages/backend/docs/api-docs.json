{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Plataforma de Comercio Electrónico",
        "version": "1.0.0",
        "description": ""
    },
    "paths": {
        "/pedido": {
            "get": {
                "summary": "Listar pedidos",
                "responses": {
                    "200": {
                        "description": "Lista de pedidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Pedidos"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No hay pedidos"
                    }
                }
            },
            "post": {
                "summary": "Crear un pedido",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PedidoInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pedido creado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Pedido"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/pedido/cancelar": {
            "post": {
                "summary": "Cancelar pedido",
                "parameters": [
                    {
                        "in": "query",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "description": "Cancelar pedido mediante ID numérico del pedido",
                "responses": {
                    "200": {
                        "description": "Pedido cancelado"
                    }
                }
            }
        },
        "/pedido/enviar": {
            "post": {
                "summary": "Enviar pedido",
                "parameters": [
                    {
                        "in": "query",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "description": "Enviar pedido mediante ID numérico del pedido",
                "responses": {
                    "200": {
                        "description": "Pedido enviado"
                    }
                }
            }
        },
        "/producto": {
            "get": {
                "summary": "Listar productos",
                "responses": {
                    "200": {
                        "description": "Lista de productos",
                        "content": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Productos"
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No hay productos"
                    }
                }
            },
            "post": {
                "summary": "Crear un producto",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductoInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Pedido"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/usuario": {
            "get": {
                "summary": "Listar usuarios",
                "responses": {
                    "200": {
                        "description": "Lista de usuarios",
                        "content": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Usuarios"
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No hay usuarios"
                    }
                }
            },
            "post": {
                "summary": "Crear un usuario",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioInput"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "usuario creado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Usuario"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/usuario/:id/notificaciones": {
            "get": {
                "summary": "Listar Notificaciones",
                "description": "Lista de notificaciones basado en un ID de usuario",
                "parameters": [
                    {
                        "in": "query",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de notificaciones",
                        "content": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Notificaciones"
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No hay notificaciones"
                    }
                }
            }
        },
        "/usuario/:id/notificaciones/:notificacionId": {
            "get": {
                "summary": "Buscar Notificación",
                "description": "Buscar notificación basado en un ID de usuario y el ID de la notificación",
                "parameters": [
                    {
                        "in": "query",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "idNotifación",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Notificación creada",
                        "content": {}
                    },
                    "404": {
                        "description": "Notificación no existe"
                    }
                }
            }
        },
        "/usuario/:id/pedidos": {
            "get": {
                "summary": "Listar pedidos por usuario",
                "description": "Lista de pedidos basado en un ID de usuario",
                "parameters": [
                    {
                        "in": "query",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de pedidos",
                        "content": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Pedidos"
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No hay pedidos"
                    }
                }
            }
        },
        "/health-check": {
            "get": {
                "summary": "Obtener estado",
                "responses": {
                    "200": {
                        "description": "Estado: ok"
                    }
                }
            }
        },
        "/categorias": {
            "get": {
                "summary": "Listar categorías",
                "responses": {
                    "200": {
                        "description": "Lista de categorías",
                        "content": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Categorias"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Crear una categoría",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CategoriaInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Categoría almacenada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Categoria"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "TipoUsuario": {
                "type": "string",
                "enum": [
                    "COMPRADOR",
                    "VENDEDOR",
                    "ADMIN"
                ]
            },
            "Moneda": {
                "type": "string",
                "enum": [
                    "PESO_ARG",
                    "DOLAR_USA",
                    "REAL"
                ]
            },
            "Estado": {
                "type": "string",
                "description": "Estado del pedido",
                "enum": [
                    "PENDIENTE",
                    "CONFIRMADO",
                    "EN_PREPARACION",
                    "ENVIADO",
                    "ENTREGADO",
                    "CANCELADO"
                ]
            },
            "Direccion": {
                "type": "object",
                "properties": {
                    "calle": {
                        "type": "string"
                    },
                    "altura": {
                        "type": "string"
                    },
                    "piso": {
                        "type": "string"
                    },
                    "departamento": {
                        "type": "string"
                    },
                    "codigoPostal": {
                        "type": "string"
                    },
                    "ciudad": {
                        "type": "string"
                    },
                    "provincia": {
                        "type": "string"
                    },
                    "pais": {
                        "type": "string"
                    },
                    "lat": {
                        "type": "string"
                    },
                    "lon": {
                        "type": "string"
                    }
                },
                "required": [
                    "calle",
                    "altura",
                    "piso",
                    "departamento",
                    "codigoPostal",
                    "ciudad",
                    "provincia",
                    "pais",
                    "lat",
                    "lon"
                ]
            },
            "Item": {
                "type": "object",
                "properties": {
                    "producto": {
                        "$ref": "#/components/schemas/Producto"
                    },
                    "cantidad": {
                        "type": "integer"
                    },
                    "precioUnitario": {
                        "type": "double"
                    }
                }
            },
            "Notificacion": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "usuarioDestino": {
                        "$ref": "#/components/schemas/Usuario"
                    },
                    "mensaje": {
                        "type": "string"
                    },
                    "fechaAlta": {
                        "type": "date"
                    },
                    "leida": {
                        "type": "boolean"
                    },
                    "fechaLeida": {
                        "type": "date"
                    }
                }
            },
            "Pedido": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "comprador": {
                        "type": "usuario"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Item"
                        }
                    },
                    "total": {
                        "type": "double"
                    },
                    "moneda": {
                        "$ref": "#/components/schemas/Moneda"
                    },
                    "direccionEntrega": {
                        "$ref": "#/components/schemas/Direccion"
                    },
                    "estado": {
                        "$ref": "#/components/schemas/Estado"
                    },
                    "fechaCreacion": {
                        "type": "date"
                    },
                    "historialEstados": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Cambio"
                        }
                    }
                }
            },
            "Producto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "vendedor": {
                        "$ref": "#/components/schemas/Usuario"
                    },
                    "titulo": {
                        "type": "string"
                    },
                    "descripcion": {
                        "type": "string"
                    },
                    "categorias": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Categoria"
                        }
                    },
                    "precio": {
                        "type": "double"
                    },
                    "moneda": {
                        "$ref": "#/components/schemas/Moneda"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "fotos": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "activo": {
                        "type": "boolean"
                    }
                }
            },
            "Cambio": {
                "type": "object",
                "properties": {
                    "fecha": {
                        "type": "date"
                    },
                    "estado": {
                        "$ref": "#/components/schemas/Estado"
                    },
                    "pedido": {
                        "$ref": "#/components/schemas/Pedido"
                    },
                    "usuario": {
                        "$ref": "#/components/schemas/Usuario"
                    },
                    "motivo": {
                        "type": "string"
                    }
                }
            },
            "Usuario": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": "string"
                    },
                    "tipo": {
                        "$ref": "#/components/schemas/TipoUsuario"
                    },
                    "fechaAlta": {
                        "type": "date"
                    }
                }
            },
            "Categoria": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string"
                    }
                }
            },
            "Pedidos": {
                "type": "object",
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/Pedido"
                    }
                }
            },
            "Productos": {
                "type": "object",
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/Producto"
                    }
                }
            },
            "Usuarios": {
                "type": "object",
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/Usuario"
                    }
                }
            },
            "Notificaciones": {
                "type": "object",
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/Notificacion"
                    }
                }
            },
            "Categorias": {
                "type": "object",
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/Categoria"
                    }
                }
            },
            "PedidoInput": {},
            "ProductoInput": {},
            "UsuarioInput": {},
            "CategoriaInput": {},
            "Clase incorrecta": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "El valor no pertenece a la clase esperada: "
                    }
                }
            },
            "Email invalido": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "La siguiente dirección de email no cumple con el formato correcto: @gmail.com"
                    }
                }
            },
            "Formato invalido": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "La siguiente id no cumple con el formato correcto: "
                    }
                }
            },
            "Zod Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": ""
                    }
                }
            },
            "Cancelar enviado": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": ": No se puede cancelar un producto ya enviado"
                    }
                }
            },
            "Moneda inconsistente": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "message": "Todos los itemes de un pedido deben tener asociada la misma moneda"
                    }
                }
            },
            "Sin Stock": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "message": "No hay stock suficiente para realizar el pedido"
                    }
                }
            },
            "Not found": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": ""
                    }
                }
            },
            "No cumple enum": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": ""
                    }
                }
            }
        }
    }
}